{
  "enabled": true,
  "default_working_directory": "$TENANT_WORKSPACE",
  "allowed_roots": [
    "$TENANT_WORKSPACE"
  ],
  "denied_globs": [
    ".git/**",
    "**/.git/**",
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key"
  ],
  "approval_ttl_seconds": 300,
  "max_tool_rounds": 6,
  "max_total_tool_calls": 12,
  "max_read_bytes": 131072,
  "max_write_bytes": 131072,
  "max_directory_entries": 500,
  "max_search_results": 200,
  "max_command_output_bytes": 65536,
  "default_command_timeout_seconds": 60,
  "max_command_timeout_seconds": 120,
  "enabled_command_profiles": [
    "python",
    "git_readonly",
    "node",
    "npm_script",
    "ollama_readonly",
    "workspace_script"
  ],
  "ocr": {
    "enabled": true,
    "auto_process_chat_images": true,
    "engine": "paddleocr",
    "device": "cpu",
    "model_tier": "small",
    "model_directory": "$SYSTEM_DATA_DIR/ocr_models",
    "max_input_bytes": 20971520,
    "max_pdf_pages": 10,
    "max_image_pixels": 25000000,
    "max_output_chars": 20000,
    "startup_timeout_seconds": 120,
    "request_timeout_seconds": 60
  }
}
