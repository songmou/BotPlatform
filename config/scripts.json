{
  "scripts": [
    {
      "id": "autogen_monitor",
      "name": "悟空 AI 文生图监控",
      "description": "续写带参考图的连载故事场景，并保存本次图片。",
      "entrypoint": "src/core/jobs/autogen/monitor.py",
      "timeout_seconds": 900,
      "requires_approval": false,
      "data_directory": "autogen",
      "parameters": {
        "reset_story": {
          "type": "string",
          "required": false,
          "choices": ["true"],
          "flag": "--reset-story"
        }
      },
      "artifact_types": ["image"]
    },
    {
      "id": "ctsehr_check",
      "name": "CTS EHR 考勤与待审批检查",
      "description": "只读汇总昨天和今天的 OA 考勤记录及待审批，并生成摘要与 PNG 报告。",
      "entrypoint": "src/core/jobs/ctsehr/monitor.py",
      "timeout_seconds": 300,
      "requires_approval": false,
      "data_directory": "ctsehr",
      "parameters": {
        "date": {
          "type": "date",
          "required": false,
          "flag": "--date"
        }
      },
      "artifact_types": ["image"]
    }
  ]
}
