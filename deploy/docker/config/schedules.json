      "enabled": false,
      "cron": "0 8,14 * * *",
      "target": "last_active_user",
      "action": {
        "type": "script",
        "script_id": "autogen_monitor",
        "parameters": {}
      }
    },
    {
      "id": "ctsehr_check",
      "enabled": false,
      "crons": [
        "50 8 * * *",
        "0 18 * * *"
      ],
      "target": "last_active_user",
      "action": {
        "type": "script",
        "script_id": "ctsehr_check",
        "parameters": {}
      }
    },
    {
      "id": "todo_reminder",
      "enabled": false,
      "crons": [
        "0 9 * * *",
        "0 18 * * *"
